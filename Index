<script>
// ── PARTICLES ──
const canvas=document.getElementById('bg-canvas');
const ctx=canvas.getContext('2d');
function rsz(){canvas.width=innerWidth;canvas.height=innerHeight;}
rsz();addEventListener('resize',rsz);
const pts=Array.from({length:50},()=>({x:Math.random()*innerWidth,y:Math.random()*innerHeight,vx:(Math.random()-.5)*.25,vy:(Math.random()-.5)*.25,r:Math.random()*1.2+.3,a:Math.random()*.3+.05,c:Math.random()>.5?'140,40,220':'100,20,160'}));
function drawBg(){ctx.clearRect(0,0,canvas.width,canvas.height);pts.forEach(p=>{p.x+=p.vx;p.y+=p.vy;if(p.x<0)p.x=canvas.width;if(p.x>canvas.width)p.x=0;if(p.y<0)p.y=canvas.height;if(p.y>canvas.height)p.y=0;ctx.beginPath();ctx.arc(p.x,p.y,p.r,0,Math.PI*2);ctx.fillStyle=`rgba(${p.c},${p.a})`;ctx.fill();});requestAnimationFrame(drawBg);}
drawBg();

// ── AUTH ──
const HASH='2ac878b0e2180616993b4b6aa71e61166fdc86c28d47e359d0ee537eb11d46d3';
async function sha256(s){const b=await crypto.subtle.digest('SHA-256',new TextEncoder().encode(s));return Array.from(new Uint8Array(b)).map(x=>x.toString(16).padStart(2,'0')).join('');}

async function doLogin(){
  const user=document.getElementById('inp-user').value.trim();
  const pass=document.getElementById('inp-pass').value;
  const btn=document.getElementById('btn-login');
  const err=document.getElementById('login-error');
  if(!user||!pass){showErr('Preencha todos os campos.');return;}
  btn.innerHTML='<span class="spinner"></span>AUTENTICANDO...';
  btn.disabled=true;err.classList.remove('show');
  const h=await sha256(pass);
  await new Promise(r=>setTimeout(r,900));
  if(h===HASH){
    localStorage.setItem('htr_tok',btoa(user+':'+Date.now()));
    localStorage.setItem('htr_usr',user);
    setUser(user);
    document.getElementById('login-screen').classList.add('hidden');
    document.getElementById('app-screen').classList.remove('hidden');
    loadToggles();updateStats();
  } else {
    btn.innerHTML='ENTRAR NO SISTEMA';btn.disabled=false;
    showErr('Credenciais inválidas. Tente novamente.');
  }
}

function setUser(u){
  document.getElementById('cfg-user').textContent=u;
  document.getElementById('dash-user-label').textContent='Logado como: '+u;
}

function showErr(m){const e=document.getElementById('login-error');e.textContent=m;e.classList.remove('show');void e.offsetWidth;e.classList.add('show');}

document.getElementById('inp-pass').addEventListener('keydown',e=>{if(e.key==='Enter')doLogin();});
document.getElementById('inp-user').addEventListener('keydown',e=>{if(e.key==='Enter')doLogin();});

function doLogout(){
  localStorage.removeItem('htr_tok');localStorage.removeItem('htr_usr');
  document.getElementById('app-screen').classList.add('hidden');
  document.getElementById('login-screen').classList.remove('hidden');
  document.getElementById('inp-pass').value='';
  document.getElementById('btn-login').innerHTML='ENTRAR NO SISTEMA';
  document.getElementById('btn-login').disabled=false;
}

(()=>{
  const tok=localStorage.getItem('htr_tok');
  const usr=localStorage.getItem('htr_usr');
  if(tok&&usr){setUser(usr);document.getElementById('login-screen').classList.add('hidden');document.getElementById('app-screen').classList.remove('hidden');loadToggles();updateStats();}
})();

// ── NAV ──
function goPage(id,el){
  document.querySelectorAll('.page').forEach(p=>p.classList.remove('active'));
  document.querySelectorAll('.tab').forEach(t=>t.classList.remove('active'));
  document.getElementById('page-'+id).classList.add('active');
  el.classList.add('active');
  document.querySelector('.scroll-area').scrollTop=0;
}
function openFF(){
  const ua = navigator.userAgent || navigator.vendor || window.opera;

  // Android
  if (/android/i.test(ua)) {
    window.location.href = 'intent://#Intent;package=com.dts.freefireth;end';
    return;
  }

  // iPhone / iPad
  if (/iPad|iPhone|iPod/.test(ua) && !window.MSStream) {
    window.location.href = 'freefire://';
    return;
  }

  // Fallback caso esteja no PC ou não consiga identificar
  window.open('https://ff.garena.com', '_blank');
}

// ── TOGGLES ──
const state={};
function loadToggles(){
  const saved=JSON.parse(localStorage.getItem('htr_toggles')||'{}');
  Object.keys(saved).forEach(k=>{if(saved[k])applyOn(k);});
}
function save(){localStorage.setItem('htr_toggles',JSON.stringify(state));}
function applyOn(id){
  state[id]=true;
  document.getElementById('fc-'+id)?.classList.add('on');
  const s=document.getElementById('st-'+id);if(s)s.textContent='ATIVADO';
}
function applyOff(id){
  state[id]=false;
  document.getElementById('fc-'+id)?.classList.remove('on');
  const s=document.getElementById('st-'+id);if(s)s.textContent='DESATIVADO';
}
function toggleFeature(id){
  if(state[id]){applyOff(id);save();updateStats();}
  else{showTerminal(id);}
}
function updateStats(){
  document.getElementById('stat-mira').textContent=['mira-leve','mira-precisa','estabilizacao','recuo','precisao'].filter(k=>state[k]).length;
  document.getElementById('stat-desemp').textContent=['fps','delay','estabilidade','touch','boost'].filter(k=>state[k]).length;
}

// ── TERMINAL ──
const LINES={
  'mira-leve':    ['Conectando ao módulo...','Carregando parâmetros de mira...','Aplicando suavização leve...','Módulo de mira leve ativo.'],
  'mira-precisa': ['Conectando ao módulo...','Injetando parâmetros de precisão...','Calibrando sensores de alvo...','Mira precisa sincronizada.'],
  'estabilizacao':['Conectando ao módulo...','Analisando micro oscilações...','Injetando filtro de estabilidade...','Tremedeira removida com sucesso.'],
  'recuo':        ['Conectando ao módulo...','Carregando perfil de tracking...','Ajustando suavização de mira...','Estabilização de mira ativa.'],
  'precisao':     ['Conectando ao módulo...','Detectando padrão de flick...','Removendo travas de sensibilidade...','Sensi sem congelamento pronto.'],
  'fps':          ['Conectando ao módulo...','Analisando carga do processador...','Otimizando pipeline de renderização...','Performance máxima ativada.'],
  'delay':        ['Conectando ao módulo...','Escaneando servidores de rede...','Reduzindo latência do sistema...','Delay minimizado com sucesso.'],
  'estabilidade': ['Conectando ao módulo...','Verificando memória do sistema...','Aplicando perfil de estabilidade...','Sistema estabilizado e pronto.'],
  'touch':        ['Conectando ao módulo...','Lendo dados de toque do display...','Calibrando sensibilidade touch...','Ajuste de sensibilidade aplicado.'],
  'boost':        ['Conectando ao módulo...','Injetando parâmetros...','Sincronizando sistema...','Aplicando otimização...','Sistema pronto.'],
};

let termTarget=null;

function showTerminal(id){
  termTarget=id;
  const modal=document.getElementById('terminal-modal');
  const body=document.getElementById('term-body');
  body.innerHTML='';
  modal.classList.add('show');

  const lines=LINES[id]||['Conectando ao módulo...','Aplicando configurações...','Sistema pronto.'];
  let i=0;

  // processing row
  const proc=document.createElement('div');
  proc.className='term-processing';
  proc.innerHTML='<div class="term-spinner"></div><span>PROCESSANDO...</span>';
  body.appendChild(proc);

  // cursor row
  const curRow=document.createElement('div');
  curRow.style.marginTop='8px';
  curRow.innerHTML='<span class="term-cursor"></span>';
  body.appendChild(curRow);

  function next(){
    if(i>=lines.length){
      proc.remove();curRow.remove();
      const done=document.createElement('div');
      done.className='term-line';
      done.innerHTML=`<span class="term-prompt">root@headtrick:~#</span><span class="term-text term-done-text"> ✓ Módulo ativado com sucesso.</span>`;
      body.appendChild(done);
      const nc=document.createElement('div');
      nc.style.marginTop='8px';
      nc.innerHTML='<span class="term-cursor"></span>';
      body.appendChild(nc);
      setTimeout(()=>{
        modal.classList.remove('show');
        applyOn(termTarget);save();updateStats();
        termTarget=null;
      },1100);
      return;
    }
    const ln=document.createElement('div');
    ln.className='term-line';
    ln.innerHTML=`<span class="term-prompt">root@headtrick:~#</span><span class="term-text"> ${lines[i]}</span>`;
    body.insertBefore(ln,proc);
    i++;
    setTimeout(next,560);
  }

  setTimeout(next,350);
}

document.getElementById('terminal-modal').addEventListener('click',function(e){
  if(e.target===this){this.classList.remove('show');termTarget=null;}
});
</script>
